# URL of the Notestaker Next.js server (the repo root app). It holds the
# Anthropic and Deepgram keys; the mobile app never ships with them.
EXPO_PUBLIC_API_URL=https://your-notestaker.vercel.app
# Where "Upgrade" buttons go. Hidden when unset. See the pricing notes in the root README
# for App Store rules on linking out vs in-app purchase.
EXPO_PUBLIC_UPGRADE_URL=
