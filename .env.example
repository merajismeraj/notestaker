# Required: generates minutes, summaries and action items.
ANTHROPIC_API_KEY=

# Optional: enables "Record → auto-detect speakers" (server-side diarization).
# Without it the app uses on-device live speech-to-text with tap-to-tag speakers.
DEEPGRAM_API_KEY=

# Optional: Google Calendar import (OAuth Web client ID, no secret needed).
# Add your app origin(s) to "Authorized JavaScript origins" in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Accounts & plans -------------------------------------------------------
# Required in production: signs session tokens. Generate: openssl rand -base64 48
AUTH_SECRET=
# Postgres (Neon recommended). Without it, an embedded Postgres in .data/ is used locally.
DATABASE_URL=
# Email sign-in codes (Resend). Without it, codes print to the dev server console.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Notestaker <login@yourdomain.com>"
# Google sign-in: every OAuth client ID whose tokens you accept (web, iOS, Android), comma-separated.
# Defaults to NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the iOS bundle ID(s) tokens are issued for.
APPLE_BUNDLE_IDS=com.notestaker.app
# Grant plans before billing exists, e.g. "you@co.com:pro,cto@co.com:team"
PLAN_OVERRIDES=
# Where "Upgrade" buttons go (your Stripe Checkout / pricing page). Hidden when unset.
NEXT_PUBLIC_UPGRADE_URL=
